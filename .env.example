# Copy to .env (git-ignored) and fill in. Never commit real values.

# ---------------------------------------------------------------------------------------------
# yeackbot server (packages/server). Loaded by the LaunchAgent via --env-file-if-exists=<repo>/.env
# ---------------------------------------------------------------------------------------------
NODE_ENV=production
HOST=127.0.0.1
PORT=4320
# Data dir (0700): yeackbot.db, backups/, logs/, admin.sock, collector.token. Default if unset:
# ~/Library/Application Support/Yeackbot
YB_DATA_DIR=

# Cloudflare Access: team name (<team>.cloudflareaccess.com), the Access application's AUD tag, and the one
# email allowed in.
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
ALLOWED_EMAIL=owner@example.com

# AES-256-GCM key for the secrets table (Beeper/Partiful/Google tokens, VAPID key): openssl rand -base64 32
SECRETS_KEY=

# Signed collector (BlackbookServer.app) on loopback; its bearer token file (0600) lives in the data dir.
COLLECTOR_URL=http://127.0.0.1:4321
COLLECTOR_TOKEN_FILE=

# Optional until the LLM phase.
ANTHROPIC_API_KEY=

# Web Push (npx web-push generate-vapid-keys); all three or none. Subject e.g. mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Development only (refused when NODE_ENV=production): skip the Access JWT check.
# DEV_AUTH_BYPASS=1
# LOG_STDERR=1

# ---------------------------------------------------------------------------------------------
# Legacy native-app CI/CD (retired in Phase 6). GitHub Actions secrets, not used by the server.
# ---------------------------------------------------------------------------------------------
# App Store Connect API Key (generate at App Store Connect > Users > Integrations)
ASC_KEY_ID=                  # Key ID from App Store Connect
ASC_ISSUER_ID=               # Issuer ID from App Store Connect
ASC_KEY_CONTENT=             # Base64-encoded .p8 file (CI only; locally place file at ~/private_keys/)

# App Store Connect
ITC_TEAM_ID=                 # App Store Connect team ID

# Fastlane Match (code signing)
MATCH_GIT_URL=               # Private git URL for certificates repo
MATCH_PASSWORD=              # Match encryption password
MATCH_GIT_BASIC_AUTHORIZATION=  # Base64(username:personal_access_token)
